# my.telegram.org -> API development tools -> Create application
# App api_id (a number)
API_ID=123456
# App api_hash (32 hex characters) — keep secret, never commit
API_HASH=0123456789abcdef0123456789abcdef

# Users whose activity is logged, one "id:Nickname" pair per user, comma
# separated. The nickname prefixes every log line, so several users can share
# one log chat without confusion.
TARGET_USERS=123456789:Alice,987654321:Bob

# Single-user fallback (used only when TARGET_USERS is empty). Nickname defaults
# to the numeric id; set TARGET_NICKNAME to override it.
# TARGET_USER_ID=123456789
# TARGET_NICKNAME=Alice

# Chat/channel that receives the log messages (numeric id, groups start with -100)
LOG_CHAT_ID=-1001234567890

# Set to 1 to print every update + chat id (use this to find ids)
DEBUG=0

# Deletes carry no sender. Ids missing from the cache cannot be attributed,
# so nothing is written for them unless you set this to 1.
LOG_UNKNOWN_DELETES=0

# Post a one-line notice in the log chat when the bot stops gracefully
# (Ctrl+C, systemctl stop, tmux kill-session). Hard kills cannot be reported.
NOTIFY_ON_STOP=1
# Also post "[STARTED] forwarding resumed" on boot. A STARTED with no STOPPED
# in front of it means the previous run crashed.
NOTIFY_ON_START=0
