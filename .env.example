# my.telegram.org -> API development tools -> Create application
# App api_id (a number)
API_ID=123456
# App api_hash (32 hex characters) — keep secret, never commit
API_HASH=0123456789abcdef0123456789abcdef

# The ONE user whose activity is logged (numeric id, not @username)
TARGET_USER_ID=123456789

# Chat/channel that receives the log messages (numeric id, groups start with -100)
LOG_CHAT_ID=-1001234567890
